{
  "name": "guandanai",
  "version": "1.14.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "description": "Online four-player GuanDan with browser-local policy inference",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "eval:profiles": "node scripts/evaluate-profiles.mjs",
    "format": "prettier --write \"src/**/*.{js,mjs,css,html}\" \"scripts/**/*.mjs\" \"tests/*.mjs\" \"docs/**/*.md\" \"*.md\" \".github/**/*.yml\" package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{js,mjs,css,html}\" \"scripts/**/*.mjs\" \"tests/*.mjs\" \"docs/**/*.md\" \"*.md\" \".github/**/*.yml\" package.json .prettierrc.json",
    "eval:response": "node scripts/evaluate-response.mjs",
    "eval:endgame": "node scripts/evaluate-endgame.mjs",
    "eval:table": "node scripts/evaluate-table.mjs",
    "train:continuous": "node scripts/continuous/supervisor.mjs",
    "train:status": "node scripts/continuous/status.mjs",
    "train:dashboard": "node scripts/continuous/dashboard.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2",
    "onnxruntime-node": "1.31.1",
    "prettier": "^3.9.10"
  }
}
